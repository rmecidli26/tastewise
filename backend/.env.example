# ---- Server ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
# Only needed if the frontend is served from a different domain (comma-separated)
CORS_ORIGIN=

# ---- PostgreSQL ----
DATABASE_URL=postgres://tastewise:tastewise@localhost:5432/tastewise
# Set to true for hosted databases that require SSL (Render, Railway, Neon, ...)
DATABASE_SSL=false

# ---- Auth ----
# Use a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7

# ---- Email (SMTP) ----
# Leave SMTP_HOST empty in development: codes are printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Tastewise by AFA <no-reply@tastewise.az>"
